# ─────────────────────────────────────────────
#  BMedia API — Production Environment Variables
#  Copy this file to .env and fill in the values
#  NEVER commit .env to source control
# ─────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────
POSTGRES_DB=bmedia_db
POSTGRES_USER=bmedia_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=bmedia_db;Username=bmedia_user;Password=CHANGE_ME_STRONG_PASSWORD;

# ── Redis ─────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_CONNECTION_STRING=redis:6379,password=CHANGE_ME_REDIS_PASSWORD

# ── JWT ───────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_-base64_64
JWT_ISSUER=bmedia-api
JWT_AUDIENCE=bmedia-clients

# ── Admin Seed ────────────────────────────────
# Password for the auto-seeded admin@bmedia.io account (first run only)
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ── Azure Blob Storage ────────────────────────
STORAGE_PROVIDER=Azure
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=bmedia-assets
AZURE_STORAGE_BASE_URL=https://YOUR_ACCOUNT.blob.core.windows.net

# ── CORS ─────────────────────────────────────
FRONTEND_URL=https://bmedia.io

# ── Hangfire Dashboard ────────────────────────
HANGFIRE_USER=admin
HANGFIRE_PASSWORD=CHANGE_ME_HANGFIRE_PASSWORD

# ── pgAdmin (optional, tools profile only) ───
PGADMIN_EMAIL=admin@bmedia.io
PGADMIN_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD
