# Database
POSTGRES_DB=bmedia_db
POSTGRES_USER=bmedia_user
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=bmedia_db;Username=bmedia_user;Password=CHANGE_THIS_STRONG_PASSWORD;

# Redis
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD
REDIS_CONNECTION_STRING=redis:6379,password=CHANGE_THIS_REDIS_PASSWORD

# JWT - Generate with: openssl rand -base64 64
JWT_SECRET_KEY=CHANGE-THIS-TO-A-MINIMUM-256-BIT-RANDOM-KEY-FOR-PRODUCTION
JWT_ISSUER=bmedia-api
JWT_AUDIENCE=bmedia-clients

# PgAdmin (optional)
PGADMIN_EMAIL=admin@bmedia.io
PGADMIN_PASSWORD=CHANGE_THIS_PGADMIN_PASSWORD
